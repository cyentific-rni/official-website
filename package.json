{
  "name": "cyentific-website",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && node --test tests/*.test.mjs",
    "check:build": "node scripts/check-build.mjs",
    "build": "npm run check && node scripts/build.mjs",
    "build:preview": "npm run check && node scripts/build-preview.mjs",
    "preview": "astro preview",
    "test:browser": "playwright test",
    "export": "node scripts/export-source.mjs",
    "assets:share": "node scripts/render-social-card.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/test": "1.63.0",
    "axe-core": "4.14.0",
    "typescript": "6.0.2"
  }
}
