# Set the intended public HTTPS origin before a production build.
# GitHub Pages project site. Set SITE_PREVIEW=true for a noindex review build.
SITE_URL=https://cyentific-rni.github.io
SITE_BASE=/official-website/

# Optional direct enquiry service. All three values are required to enable it.
# The endpoint must accept JSON POST requests and allow CORS from SITE_URL.
PUBLIC_CONTACT_ENDPOINT=
CONTACT_PROVIDER_NAME=
CONTACT_PROVIDER_PRIVACY_URL=
