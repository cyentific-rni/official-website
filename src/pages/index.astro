---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import EvidenceMap from '../components/EvidenceMap.astro';
import Workflow from '../components/Workflow.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import home from '../content/home.json';
import site from '../content/site.json';
const base=import.meta.env.BASE_URL;
---
<Base title="Connected cyber intelligence. Informed action." description="Connect security data, infrastructure and business context. Explore OMNIRES and specialist CTI, knowledge engineering and security automation services.">
  <section class="hero"><div class="hero-grid shell"><div class="hero-copy"><span class="eyebrow eyebrow--mint"><span class="signal-dot"></span>{home.eyebrow}</span><h1>{home.headline[0]}<br/><span>{home.headline[1]}</span></h1><p>{home.description}</p><div class="hero-actions"><Button href={`${base}contact.html?interest=presentation`}>{site.primaryCta}</Button><a class="text-link text-link--light" href={`${base}services.html`}>{home.secondaryCta}<Icon name="diagonal" size={17}/></a></div><div class="hero-audience"><span>FOR COMPLEX SECURITY ENVIRONMENTS</span><p>MSSPs / MDRs <b>·</b> SOC teams <b>·</b> Security platforms</p></div></div><EvidenceMap/></div><div class="hero-bottom shell"><span>FROM EVIDENCE TO ACTION</span><div>Connect <span>→</span> Understand <span>→</span> Decide <span>→</span> Act</div><a href="#platform" aria-label="Scroll to explore the OMNIRES approach">SCROLL TO EXPLORE <span aria-hidden="true">↓</span></a></div></section>
  <section class="standards" aria-label="Technology foundations"><div class="shell standards-inner"><p>Built for interoperability.<br/><strong>Grounded in open standards.</strong></p><div><span>STIX / TAXII</span><span>CACAO</span><span>RDF / OWL</span><span>SHACL</span><span>SPARQL</span></div></div></section>
  <section class="section services-section" id="services"><div class="shell"><div class="section-heading"><div><span class="eyebrow">EXPERTISE YOU CAN USE TODAY</span><h2>Put your intelligence<br/>to work.</h2></div><p>Have a challenge to solve now? Work with our specialists on a clearly scoped CTI, knowledge or automation engagement.</p></div><div class="service-cards">{home.services.map((service,index)=><article class:list={['service-card',{'service-card--featured':index===0}]}><div class="service-card-top"><span>0{index+1} / {service.label}</span><Icon name={service.icon} size={26}/></div><h3>{service.title}</h3><p>{service.text}</p><ul>{service.items.map(item=><li><Icon name="check" size={15}/>{item}</li>)}</ul><a href={`${base}contact.html?interest=${service.id}`} class="card-link">{service.cta}<Icon name="diagonal" size={18}/></a></article>)}</div></div></section>
  <section class="section problem-section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">THE CONTEXT GAP</span><h2>Your next decision needs<br/>more than another finding.</h2></div><p>Your team has the signals. The hard part is connecting them to what matters—and deciding what happens next.</p></div><div class="problem-grid">{home.problems.map(problem=><article><div class="problem-label"><span>{problem.number}</span>{problem.label}</div><h3>{problem.title}</h3><p>{problem.text}</p></article>)}</div></div></section>
  <section class="section platform-section" id="platform"><div class="shell"><div class="section-heading"><div><span class="eyebrow">INTRODUCING OMNIRES</span><h2>Your existing stack.<br/>One connected context.</h2></div><div><p>Bring asset, software and vulnerability information into a shared context. Explore the OMNIRES approach to connecting security evidence with operational questions.</p><a class="text-link" href={`${base}omnires.html`}>Explore the platform <Icon name="diagonal" size={16}/></a></div></div><Workflow/><div class="workflow-caption"><span><span class="status-square"></span>ILLUSTRATIVE WORKFLOWS</span><p>A conceptual workflow using fictional infrastructure.</p></div></div></section>
  <section class="product-bridge"><div class="shell"><div><strong>Turn response knowledge into a connected workflow.</strong><p>Build CACAO playbooks visually with draggable integration actions, then coordinate execution with NSOAR.</p></div><a class="text-link" href={`${base}nsoar.html`}>Explore NSOAR <Icon name="diagonal" size={17}/></a></div></section>
  <section class="section audience-section"><div class="shell audience-grid"><div><span class="eyebrow">BUILT FOR YOUR OPERATING REALITY</span><h2>Complex environments.<br/>Clearer decisions.</h2></div><div class="audience-items"><article><h3>MSSPs &amp; MDR providers</h3><p>Bring heterogeneous customer environments into context and make the reasoning behind a recommendation easier to explain.</p></article><article><h3>SOCs &amp; security teams</h3><p>Investigate dependencies and business impact, then coordinate the response around the available evidence.</p></article><article><h3>Security technology teams</h3><p>Extend existing platforms with structured intelligence, semantic context and interoperable automation.</p></article></div></div></section>
  <section class="section credibility-section"><div class="shell credibility-grid"><div><span class="eyebrow">THE WORK BEHIND THE APPROACH</span><h2>Research depth.<br/>Engineering you<br/>can inspect.</h2><p>Our expertise connects cybersecurity standards, open tooling and applied European research.</p><a href={`${base}company.html`} class="text-link">Meet Cyentific <Icon name="diagonal" size={17}/></a></div><div class="credibility-links"><a href="https://github.com/opencybersecurityalliance/cacao-roaster" target="_blank" rel="noopener noreferrer"><span class="proof-category">OPEN TOOLING</span><div><h3>CACAO Roaster</h3><Icon name="diagonal" size={22}/></div><p>Open-source playbook tooling published through the Open Cybersecurity Alliance.</p><span class="proof-source">github.com / opencybersecurityalliance</span></a><a href="https://github.com/oasis-open/cacao-json-schemas" target="_blank" rel="noopener noreferrer"><span class="proof-category">INTEROPERABILITY</span><div><h3>CACAO schemas</h3><Icon name="diagonal" size={22}/></div><p>Public schema work supporting structured and interoperable security playbooks.</p><span class="proof-source">github.com / oasis-open</span></a><a href={`${base}company.html#contributions`}><span class="proof-category">APPLIED EXPERIENCE</span><div><h3>European R&amp;D</h3><Icon name="diagonal" size={22}/></div><p>Explore X-MESH, the TAC ontology and playbook exchange contributions.</p><span class="proof-source">Public repositories and project publications</span></a></div></div></section>
  <section class="section faq-section"><div class="shell faq-grid"><div><span class="eyebrow">BEFORE WE TALK</span><h2>A few useful<br/>answers.</h2><p>Ideas for connecting your environment, shaping a use case and working together.</p></div><Faq/></div></section>
  <ClosingCta/>
</Base>
