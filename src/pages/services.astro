---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import ClosingCta from '../components/ClosingCta.astro';
import services from '../content/services.json';
const base=import.meta.env.BASE_URL;
---
<Base title="CTI, knowledge engineering & automation services" description="Specialist CTI consultancy, security ontologies, STIX/TAXII integration and CACAO automation. Start with a scoped engagement around your operational challenge.">
  <section class="page-hero"><div class="shell"><span class="eyebrow">CYENTIFIC SERVICES</span><h1>{services.title[0]}<br/><span>{services.title[1]}</span></h1><p>{services.description}</p><div class="button-group"><Button variant="dark" href={`${base}contact.html?interest=cti`}>Discuss your challenge</Button><a class="text-link" href="#cti">Explore the services <Icon name="diagonal" size={16}/></a></div></div></section>
  <section class="section"><div class="shell">{services.offerings.map(service=><article class="service-detail" id={service.id}><span class="service-detail-number">{service.number} /</span><div><h2>{service.title}</h2><p>{service.problem}</p><p>{service.approach}</p><a class="text-link" href={`${base}contact.html?interest=${service.id}`}>{service.cta}<Icon name="diagonal" size={17}/></a></div><div class="service-scope"><h3>EXAMPLE ENGAGEMENT SCOPE</h3><ul>{service.deliverables.map(item=><li><Icon name="check" size={15}/>{item}</li>)}</ul></div></article>)}</div></section>
  <section class="section soft-section" id="example"><div class="shell"><div class="section-heading"><div><span class="eyebrow">{services.example.label}</span><h2>{services.example.title}</h2></div><p>{services.example.description}</p></div><div class="engagement-grid">{services.example.steps.map((step,index)=><article><span>0{index+1} /</span><h3>{step.title}</h3><p>{step.text}</p></article>)}</div><p class="example-acceptance">{services.example.acceptance}</p><a class="text-link" href={`${base}contact.html?interest=cti`}>Discuss a similar workflow <Icon name="diagonal" size={17}/></a></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">A PRACTICAL WAY TO START</span><h2>One challenge.<br/>A scope we can deliver.</h2></div><p>Define the outcome around your environment, with commercial terms and acceptance criteria set out in the proposal.</p></div><div class="engagement-grid">{services.process.map((step,i)=><div><span>0{i+1} /</span><h3>{step.title}</h3><p>{step.text}</p></div>)}</div></div></section>
  <ClosingCta interest="cti" primaryLabel="Discuss your challenge" title="What’s slowing your team down?" description="Tell us what your analysts are trying to do, where the data lives and what gets in the way."/>
</Base>
