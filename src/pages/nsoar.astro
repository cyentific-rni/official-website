---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import ClosingCta from '../components/ClosingCta.astro';
import nsoar from '../content/nsoar.json';
import site from '../content/site.json';
const base=import.meta.env.BASE_URL;
---
<Base title="NSOAR — CACAO playbooks & security orchestration" description={nsoar.description}>
  <section class="page-hero"><div class="shell"><span class="eyebrow">{nsoar.eyebrow}</span><h1>{nsoar.title[0]}<br/><span>{nsoar.title[1]}</span></h1><p>{nsoar.description}</p><div class="button-group"><Button variant="dark" href={`${base}contact.html?interest=nsoar`}>{site.primaryCta}</Button><Button variant="secondary" href="#capabilities">Explore the capabilities</Button></div><p class="product-availability">The next commercial release is in preparation. Presentations are arranged around your use case.</p></div></section>
  <section class="section"><div class="shell split-grid"><div><span class="eyebrow">CLOSE THE OPERATIONAL GAPS</span><h2>A procedure should travel<br/>further than a document.</h2></div><div><p>Analysts move between instructions, editors, integration scripts and execution views. Valuable response knowledge becomes difficult to reuse and adapt.</p><p>NSOAR connects the playbook lifecycle around a shared, standards-based representation: discover a procedure, refine the steps, coordinate execution and bring what you learn back into the workflow.</p></div></div></section>
  <section class="section nsoar-capabilities" id="capabilities"><div class="shell"><div class="section-heading"><div><span class="eyebrow eyebrow--mint">ONE CONNECTED PLAYBOOK LIFECYCLE</span><h2>Design. Coordinate.<br/>Share. Reuse.</h2></div><p>Visual authoring, reusable integration actions and execution visibility, connected around CACAO playbooks.</p></div><div class="nsoar-module-grid">{nsoar.modules.map((module,index)=><article><div class="nsoar-module-top"><span>0{index+1} / {module.name.toUpperCase()}</span><Icon name={module.icon} size={25}/></div><h3>{module.verb}</h3><p>{module.text}</p></article>)}</div><div class="nsoar-foundation"><strong>CACAO at the core</strong><p>{nsoar.registry.description}</p><a class="text-link text-link--light" href={nsoar.registry.href} target="_blank" rel="noopener noreferrer">{nsoar.registry.linkLabel} <Icon name="diagonal" size={16}/></a></div></div></section>
  <section class="section soft-section" id="integrations"><div class="shell split-grid"><div><span class="eyebrow">WORK WITH YOUR EXISTING STACK</span><h2>Connect the tools<br/>your team uses.</h2><p>{nsoar.connections.description}</p><a class="text-link" href={`${base}contact.html?interest=automation`}>Discuss your integrations <Icon name="diagonal" size={16}/></a></div><ul class="connection-list">{nsoar.connections.items.map(item=><li><h3>{item.title}</h3><p>{item.text}</p></li>)}</ul></div></section>
  <section class="section"><div class="shell"><div class="section-heading"><div><span class="eyebrow">START WITH YOUR USE CASE</span><h2>Make a familiar workflow<br/>work better.</h2></div><p>Choose one procedure, agree the tools and review points, then validate the workflow together.</p></div><div class="engagement-grid">{nsoar.useCases.map((item,index)=><article><span>0{index+1} /</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></div></section>
  <section class="section soft-section"><div class="shell split-grid"><div><span class="eyebrow">CONTEXT MEETS ORCHESTRATION</span><h2>Better-informed decisions.<br/>Structured responses.</h2></div><div><p>OMNIRES focuses on connected security context. NSOAR turns response knowledge into playbooks and coordinates their execution.</p><p>Our specialists help you choose a practical starting point across threat intelligence, knowledge engineering and automation.</p><div class="button-group"><Button variant="secondary" href={`${base}omnires.html`}>Explore OMNIRES</Button><a class="text-link" href={`${base}services.html#automation`}>Automation consultancy <Icon name="diagonal" size={16}/></a></div></div></div></section>
  <section class="section"><div class="shell faq-grid"><div><span class="eyebrow">LET’S SHAPE THE WORKFLOW</span><h2>Your procedures.<br/>Your operating context.</h2><p>Start with what your team knows and build on the tools you already use.</p></div><Faq items={nsoar.faq}/></div></section>
  <ClosingCta title="Which workflow would you connect first?" description="Bring a response procedure, an integration challenge or a product collaboration idea. Let’s explore it together." interest="nsoar" primaryLabel="Discuss NSOAR"/>
</Base>
