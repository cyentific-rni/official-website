---
import Base from '../layouts/Base.astro';
import privacy from '../content/privacy.json';
import ContactPrivacy from '../components/ContactPrivacy.astro';
---
<Base title="Privacy notice" description="How the Cyentific website and business enquiries are handled.">
  <section class="page-hero"><div class="shell"><span class="eyebrow">PRIVACY</span><h1>Privacy<br/><span>notice.</span></h1><p>How Cyentific processes personal data when you use this website or contact us.</p></div></section>
  <section class="section"><div class="shell"><article class="legal-prose">
    <Fragment set:html={privacy.intro}/>
    {privacy.sections.map(section=><Fragment><h2 id={section.id}>{section.heading}</h2>{section.kind === 'contact' ? <ContactPrivacy/> : <Fragment set:html={section.body}/>}</Fragment>)}
  </article></div></section>
</Base>
