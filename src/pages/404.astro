---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
const base=import.meta.env.BASE_URL;
---
<Base title="Page not found" description="The requested page could not be found." noindex><section class="section not-found"><div class="shell"><span class="eyebrow">404 / PAGE NOT FOUND</span><h1>Let’s find<br/>the right connection.</h1><p>This page may have moved, or the address may be incomplete.</p><Button href={base} variant="dark">Back to Cyentific</Button></div></section></Base>
