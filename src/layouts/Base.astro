---
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../content/site.json';
import {pageEntities,siteUrl} from '../lib/discovery';
import {isPreview} from '../lib/deployment';
interface Props {title:string;description:string;noindex?:boolean}
const {title,description,noindex:pageNoindex=false}=Astro.props;
const noindex = pageNoindex || isPreview;
const base=import.meta.env.BASE_URL;
const url=(path='')=>siteUrl(Astro.site,path);
const canonical=new URL(Astro.url.pathname.replace(/\/index\.html$/, '/'),Astro.site).href;
const organization={'@type':'Organization','@id':url()+'#organization',name:site.name,legalName:site.legalName,url:url(),email:site.email,logo:{'@type':'ImageObject',url:url('assets/logo-black.png'),width:1650,height:578},identifier:site.registration,address:{'@type':'PostalAddress',streetAddress:'Dimou Irodotou 20',addressLocality:'Kato Platres, Limassol',postalCode:'4815',addressCountry:'CY'}};
const isHome=canonical===url();
const graph={'@context':'https://schema.org','@graph':[
  organization,
  {'@type':'WebSite','@id':url()+'#website',name:site.name,url:url(),inLanguage:'en',publisher:{'@id':organization['@id']}},
  {'@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:`${title} | Cyentific`,description,inLanguage:'en',isPartOf:{'@id':url()+'#website'},about:{'@id':organization['@id']},...(!isHome&&!pageNoindex?{breadcrumb:{'@id':canonical+'#breadcrumb'}}:{})},
  ...(!isHome&&!pageNoindex?[{'@type':'BreadcrumbList','@id':canonical+'#breadcrumb',itemListElement:[{'@type':'ListItem',position:1,name:'Cyentific',item:url()},{'@type':'ListItem',position:2,name:title,item:canonical}]}]:[]),
  ...(!pageNoindex?pageEntities(Astro.url.pathname,Astro.site):[])
]};
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#111d31"/>
  <title>{title} | Cyentific</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex, follow':'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}/>
  <meta property="og:type" content="website"/><meta property="og:site_name" content="Cyentific"/><meta property="og:locale" content="en_GB"/><meta property="og:title" content={`${title} | Cyentific`}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={url('assets/social-card.png')}/><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:alt" content="Cyentific — Connected intelligence. Informed action."/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={`${title} | Cyentific`}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={url('assets/social-card.png')}/><meta name="twitter:image:alt" content="Cyentific — Connected intelligence. Informed action."/>
  <link rel="icon" href={`${base}assets/favicon.png`} type="image/png"/>
  <link rel="preload" href={manropeFont} as="font" type="font/woff2" crossorigin/>
  <link rel="sitemap" href={`${base}sitemap.xml`} type="application/xml"/><link rel="alternate" href={`${base}llms.txt`} type="text/plain" title="Cyentific machine-readable overview"/>
  <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g,'\\u003c')}/>
</head>
<body><Header/><main id="main"><slot/></main><Footer/><script src="../scripts/site.ts"></script></body>
</html>
